<component type="desktop-application">
  <id>io.github.aaronbamblett.tsumiru</id>
  <name>Tsumiru</name>
  <summary>Read manga from a Suwayomi server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <developer id="io.github.aaronbamblett">
    <name>Aaron Bamblett</name>
  </developer>
  <description>
    <p>
      Tsumiru reads manga, manhwa and webtoons from your own Suwayomi server.
      Your library, sources and downloads live on the server, so every device
      shows the same library and reading progress.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>Download chapters to your device and read with no connection</li>
      <li>A continuous reader for long webtoon strips, with pinch-to-zoom</li>
      <li>Library categories, sorting and filters</li>
      <li>Reading progress tracking with AniList and MyAnimeList</li>
      <li>Also available on Android, iOS, Windows, macOS and the web</li>
    </ul>
  </description>
  <keywords>
    <keyword>manga</keyword>
    <keyword>manhwa</keyword>
    <keyword>manhua</keyword>
    <keyword>webtoon</keyword>
    <keyword>comic</keyword>
    <keyword>webcomic</keyword>
    <keyword>reader</keyword>
    <keyword>offline</keyword>
    <keyword>self-hosted</keyword>
    <keyword>Suwayomi</keyword>
    <keyword>Tachidesk</keyword>
    <keyword>Tachiyomi</keyword>
    <keyword>Mihon</keyword>
  </keywords>
