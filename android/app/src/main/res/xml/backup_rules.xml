<!-- Auto Backup up to Android 11. Keep in sync with data_extraction_rules.xml.

     flutter_secure_storage's files hold the stored credentials, encrypted with
     a Keystore key that never leaves this device. Restored anywhere else they
     can't be decrypted ("Failed to unwrap key"), so they are left out: a
     restored install signs in again instead. Everything else (settings, the
     background workers' sealed records) is still backed up; without the
     Keystore-held key, the sealed records' secrets read as absent. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
